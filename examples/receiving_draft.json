{
  "title": "Inbound import receiving (draft)",
  "note": "The seed board for the review-loop demo. Drawn the way a domain expert actually draws it, NOT the way it should end up \u2014 five separate boxes for what are really five fields, no key on an invoice that arrives twice, two things pulled from one email with nothing saying which is which, two checks she described in English and never formalised, and a batch/certificate pair she never connected. This board must NOT freeze. receiving.json is where it converges.",
  "nodes": [
    {
      "id": "ch_a1",
      "primitive": "channel",
      "label": "Pre-alert inbox",
      "x": 40,
      "y": 200,
      "config": {
        "tool": "composio.gmail",
        "match": {
          "subject_patterns": [
            "Pre-Alert Documents"
          ]
        },
        "describes": "Freight forwarders email us the paperwork before a container lands."
      }
    },
    {
      "id": "ch_a2",
      "primitive": "channel",
      "label": "Forwarder resend",
      "x": 40,
      "y": 360,
      "config": {
