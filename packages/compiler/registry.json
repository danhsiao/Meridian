{
  "registry_version": "1.0",
  "kinds": {
    "channel": {
      "required": [
        "describes",
        "tool"
      ],
      "required_if": {
        "has_outputs": [
          "match"
        ],
        "has_inputs": [
          "request"
        ]
      },
      "optional": [],
      "defaults": {},
      "enums": {
        "tool": "@transport_registry"
      }
    },
    "artifact": {
      "required": [
        "describes"
      ],
      "required_if": {
        "multiple_sources": [
          "identity_key"
        ],
        "extracted_from_a_message": [
          "identity_key"
        ],
        "multiple_inbound_artifacts": [
          "pair_on"
        ],
        "sibling_artifacts_from_same_source": [
          "source_hint"
        ],
        "holds_no_child_records": [
          "fields"
        ]
      },
      "optional": [
        "computed",
        "extraction_hint"
      ],
      "defaults": {
        "computed": null,
        "extraction_hint": null
      }
    },
    "policy": {
      "required": [
        "describes",
        "on_fail",
        "on_absent"
      ],
      "required_if": {
        "resolved_to_relation": [
          "check",
          "reads",
          "confirmed_by"
        ],
        "resolved_to_impl": [
          "impl",
          "reads",
          "confirmed_by"
        ],
        "neither_resolved": [
          "check"
        ],
        "multiple_read_artifacts": [
          "verdict_on"
        ]
      },
      "optional": [],
      "defaults": {},
      "enums": {
        "relation": [
          "present",
          "absent",
          "exists_matching",
          "equals",
          "in_set",
          "greater_than",
          "less_than",
          "within",
          "older_than",
          "newer_than"
        ],
        "on_fail": [
          "halt",
          "flag_and_continue"
        ],
        "on_absent": [
          "pass",
          "fail"
        ]
      }
    },
    "output": {
      "required": [
        "describes",
        "rows"
      ],
      "optional": [],
      "defaults": {},
      "enums": {
        "fn": [
          "count",
          "sum",
          "list",
          "copy",
          "verdict"
        ]
      }
    },
    "edge": {
      "required": [],
      "required_if": {
        "endpoints_are_artifacts": [
          "rel"
        ],
        "rel_is_pairs_with": [
          "on"
        ],
        "rel_is_contains": [
          "on_child_fail"
        ]
      },
      "optional": [
        "cardinality",
        "await",
        "rescope",
        "max_attempts",
        "timeout",
        "on_exhausted"
      ],
      "defaults": {
        "cardinality": "one",
        "max_attempts": 1,
        "timeout": null,
        "on_exhausted": "escalate",
        "await": null,
        "rescope": null
      },
      "enums": {
        "cardinality": [
          "one",
          "many"
        ],
        "rel": [
          "contains",
          "pairs_with",
          "builds_from"
        ],
        "on_exhausted": [
          "escalate",
          "halt",
          "continue"
        ],
        "timeout": [
          "PT30S",
          "PT1H",
          "P1D",
          "P5D",
          "P14D"
        ],
        "max_attempts": [
          1,
          2,
          3,
          5
        ],
        "on_child_fail": [
          "ignore",
          "fail_parent"
        ]
      }
    }
  },
  "list_valued_keys": ["fields", "reads", "required", "rescope"],
  "required_if_codes": {
    "neither_resolved": "unresolved_policy"
  },
  "ask": {
    "channel.tool": {
      "binding": "control",
      "options_from": "transport_registry",
      "extensible": true,
      "intent": "We can connect to Gmail today. Is that where {it} comes from?"
    },
    "channel.match": {
      "binding": "prompt",
      "intent": "How do you recognise what belongs to {it}, and what to ignore?"
    },
    "channel.request": {
      "binding": "prompt",
      "intent": "What does {it} send, and what goes in it?"
    },
    "artifact.fields": {
      "binding": "prompt",
      "intent": "What values do you pull out of {it}?"
    },
    "artifact.source_hint": {
      "binding": "prompt",
      "intent": "Which part of what arrives is {it}?"
    },
    "artifact.identity_key": {
      "binding": "control",
      "options_from": "own_fields",
      "intent": "The same one can arrive twice. Which value tells you two of them are the same {it}?"
    },
    "artifact.pair_on": {
      "binding": "control",
      "options_from": "shared_fields_of_inbound_artifacts",
      "intent": "{it} is built from several things at once. Which value says which ones belong together?"
    },
    "policy.describes": {
      "binding": "prompt",
      "intent": "What does {it} check?"
    },
    "policy.check": {
      "binding": "derived",
      "intent": "{it} — here is what we understood. Is that right?"
    },
    "policy.impl": {
      "binding": "derived",
      "intent": "{it} — here is what we understood. Is that right?"
    },
    "policy.reads": {
      "binding": "derived",
      "multi": true,
      "options_from": "read_artifact_fields",
      "intent": "{it} looks at these values. Is that right?"
    },
    "policy.verdict_on": {
      "binding": "control",
      "options_from": "inbound_artifact_nodes",
      "intent": "{it} looks at more than one thing. When it fails, which one is at fault?"
    },
    "policy.on_fail": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "closed_because": "the orchestrator can stop or continue; a third behaviour is a fail edge, not an enum value",
      "option_labels": {
        "halt": "Stop the whole run",
        "flag_and_continue": "Flag it and carry on"
      },
      "intent": "When {it} fails, should the whole run stop, or should we flag it and carry on?"
    },
    "policy.on_absent": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "closed_because": "a check whose input is empty either passes or fails; there is no third answer",
      "option_labels": {
        "pass": "Treat it as passing",
        "fail": "Treat it as failing"
      },
      "intent": "Sometimes the values {it} looks at will be blank. Should blank count as passing, or as failing?"
    },
    "policy.confirmed_by": {
      "binding": "derived",
      "intent": "Have you signed off on {it}?"
    },
    "output.rows": {
      "binding": "prompt",
      "intent": "What should {it} tell you at the end? Write one line for each number or list you'd want — for example “how many we processed”, or “which ones need chasing”."
    },
    "edge.rel": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "intent": "{it} — how do these two relate?",
      "closed_because": "one record can sit inside another, pair with another, or be built from several — the compiler has no fourth shape",
      "option_labels": {
        "contains": "Each {from} contains {to}",
        "pairs_with": "Each {from} pairs with {to}, matched on a shared value",
        "builds_from": "Each {to} is built from several {from}"
      }
    },
    "edge.on": {
      "binding": "control",
      "options_from": "shared_fields_of_endpoints",
      "intent": "{it} — which value connects these two?"
    },
    "edge.cardinality": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "closed_because": "a step runs once or loops; there is no third arity",
      "option_labels": {
        "one": "One {to} per {from}",
        "many": "Many {to} per {from}"
      },
      "intent": "{it} — does one come through at a time, or many?"
    },
    "edge.on_exhausted": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "closed_because": "when the wait runs out the run can escalate, stop, or carry on with what it has",
      "option_labels": {
        "escalate": "Escalate to someone",
        "halt": "Stop the run",
        "continue": "Carry on with what we have"
      },
      "intent": "If nobody ever replies, what should the run do?"
    },
    "edge.timeout": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "closed_because": "a fixed set of wait durations; a custom value is an implementer edit, not a question",
      "intent": "How long should {it} wait for a reply before giving up?",
      "option_labels": {
        "PT30S": "30 seconds (demo)",
        "PT1H": "1 hour",
        "P1D": "1 day",
        "P5D": "5 days",
        "P14D": "2 weeks"
      }
    },
    "edge.max_attempts": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "closed_because": "chase counts beyond a handful mean the process needs a different escalation, not a bigger number",
      "intent": "How many times should {it} chase before giving up?"
    },
    "edge.rescope": {
      "binding": "control",
      "options_from": "upstream_artifacts_of_policy",
      "multi": true,
      "intent": "When a reply arrives, which records should be looked at again?"
    },
    "edge.await": {
      "binding": "control",
      "options_from": "inbound_channels",
      "intent": "Which channel does the reply come back on?"
    },
    "channel.describes": {
      "binding": "prompt",
      "intent": "Where does {it} connect, and what arrives or gets sent?"
    },
    "artifact.describes": {
      "binding": "prompt",
      "intent": "What is {it}, and where does it come from?"
    },
    "output.describes": {
      "binding": "prompt",
      "intent": "What gets reported at the end?"
    },
    "edge.on_child_fail": {
      "binding": "control",
      "options_from": "enum",
      "extensible": false,
      "closed_because": "a parent either inherits its children's failures or it does not; a third behaviour would need a rule about which children count, and that is a check, not a property of the line between two cards",
      "option_labels": {
        "fail_parent": "Yes — the {from} is only good if all of its {to} are",
        "ignore": "No — they're judged separately"
      },
      "intent": "Each {from} contains {to}. If a {to} fails a check, does the {from} fail too?"
    }
  },
  "templates": {
    "channel.inbound": {
      "reads": [
        "tool",
        "match"
      ]
    },
    "channel.outbound": {
      "reads": [
        "tool",
        "request"
      ]
    },
    "artifact.extract": {
      "reads": [
        "fields",
        "source_hint",
        "extraction_hint"
      ]
    },
    "artifact.identity": {
      "reads": [
        "identity_key"
      ]
    },
    "artifact.merge": {
      "reads": [
        "pair_on"
      ]
    },
    "policy.relation": {
      "reads": [
        "describes",
        "check",
        "reads",
        "on_fail",
        "on_absent",
        "verdict_on"
      ]
    },
    "policy.impl": {
      "reads": [
        "describes",
        "impl",
        "reads",
        "on_fail",
        "on_absent",
        "verdict_on"
      ]
    },
    "output.rows": {
      "reads": [
        "rows"
      ]
    },
    "edge.loop": {
      "reads": [
        "cardinality"
      ]
    },
    "edge.join": {
      "reads": [
        "on"
      ]
    },
    "edge.fail": {
      "reads": [
        "await",
        "rescope",
        "max_attempts",
        "timeout",
        "on_exhausted"
      ]
    },
    "edge.propagate": {
      "reads": [
        "on_child_fail"
      ]
    }
  },
  "reads_compiler": [
    "edge.rel",
    "edge.on",
    "edge.cardinality",
    "artifact.identity_key",
    "policy.verdict_on",
    "policy.confirmed_by",
    "edge.on_child_fail"
  ],
  "askable_if": {
    "policy.on_absent": "policy_described_and_bound",
    "policy.on_fail": "policy_described_and_bound",
    "policy.verdict_on": "policy_described_and_bound",
    "policy.check": "policy_described_and_bound",
    "policy.reads": "policy_described_and_bound",
    "policy.confirmed_by": "policy_described_and_bound",
    "artifact.identity_key": "artifact_has_fields",
    "artifact.pair_on": "artifact_has_fields",
    "artifact.source_hint": "artifact_has_fields",
    "channel.match": "channel_described",
    "channel.request": "channel_described",
    "output.rows": "output_described",
    "edge.on": "endpoints_share_a_field",
    "artifact.fields": "artifact_described",
    "channel.tool": "channel_described"
  }
}
