# Copy to .env.local and fill in — or run `npm run env:local`, which writes the
# Supabase values from the running stack and preserves anything you typed here.
# `npm run doctor` checks this file and .env.local have the same keys.
#
# Where each value comes from is marked:
#
#   [auto]    written by `npm run env:local` from `supabase status`
#   [paste]   a credential a provider issues you — the only real secrets here
#   [pick]    any string you choose; it just has to stay consistent
#   [default] plain config, not a secret, fine to commit as-is

# ── Supabase ───────────────────────────────────────────────────────────
# [auto] All four. Don't hand-edit; run `npm run env:local`.
#
# NEXT_PUBLIC_ is a Next.js convention: inlined into the CLIENT bundle. Only
# browser-safe values may carry it. The anon key qualifies; the service role
# key never does.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server side only — the review worker and the CLI. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# The bus. The canvas, the worker and the CLI all coordinate through these rows.
DATABASE_URL=

# ── Anthropic ──────────────────────────────────────────────────────────
# [paste] console.anthropic.com -> API keys. Needed by the review agent's
# Pass B and the policy resolution loop (block 3).
ANTHROPIC_API_KEY=
# [default] Pinned on purpose: extraction runs through a model, so the eval
# suite's expected values only mean something against a fixed one. Changing
# this changes fixture results with no code change.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Composio ───────────────────────────────────────────────────────────
# Only needed to fetch real messages (block 7). The review loop and freeze
# work without any of these.
#
# [paste] Composio dashboard -> API keys.
COMPOSIO_API_KEY=
# [pick] Composio namespaces connected accounts under an identifier you choose.
# Any stable string works ("default", your email). It is not issued to you —
# it only has to match between the run that authorizes Gmail and every run
# that reads from it afterwards.
COMPOSIO_USER_ID=
# [paste] Issued by Composio when you complete the Gmail OAuth flow: you start
# a connection, authorize in a browser, and it hands back an id for that
# connected account. Block 0a does this once and pins the result here.
COMPOSIO_GMAIL_CONNECTION_ID=

# ── Temporal ───────────────────────────────────────────────────────────
# None of these are secrets.
#
# [default] Where the Temporal server listens. `temporal server start-dev`
# uses 7233. Nothing runs here until block 6.
TEMPORAL_ADDRESS=localhost:7233
# [default] The dev server creates a namespace called `default`. Just a name.
TEMPORAL_NAMESPACE=default
# [pick] A queue name we invented. The worker polls it and the client targets
# it; the only requirement is that both sides say the same thing.
TEMPORAL_TASK_QUEUE=workflow-engine
# [paste] Temporal Cloud only. Unset for local — the dev server has no TLS.
# TEMPORAL_TLS_CERT=
# TEMPORAL_TLS_KEY=

# ── Run mode ───────────────────────────────────────────────────────────
# [default] capture: outbound sends are written to processes/<id>/captured/ and
# asserted against. live: they are actually delivered. Defaults to capture so a
# five-iteration heal loop over failing fixtures can't send dozens of real
# emails. Opt into live per run with --live.
CHANNEL_MODE=capture
